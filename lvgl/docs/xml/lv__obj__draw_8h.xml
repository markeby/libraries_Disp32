<parameteritem>
<parameternamelist>
<parametername>part</parametername>
</parameternamelist>
<parameterdescription>
<para>part of the object, e.g. <computeroutput>LV_PART_MAIN</computeroutput>, <computeroutput>LV_PART_SCROLLBAR</computeroutput>, <computeroutput>LV_PART_KNOB</computeroutput>, etc </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>draw_dsc</parametername>
</parameternamelist>
<parameterdescription>
