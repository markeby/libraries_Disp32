<para>init freetype library <parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>max_faces</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum number of opened FT_Face objects managed by this cache instance. Use 0 for defaults. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>max_sizes</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum number of opened FT_Size objects managed by this cache instance. Use 0 for defaults. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>max_bytes</parametername>
</parameternamelist>
<parameterdescription>
<para>Maximum number of bytes to use for cached data nodes. Use 0 for defaults. Note that this value does not account for managed FT_Face and FT_Size objects. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true on success, otherwise false. </para>
</simplesect>
</para>
